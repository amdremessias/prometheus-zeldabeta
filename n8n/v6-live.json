        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { chatId: $('Normalizar mensagem').item.json.phone, text: 'Seu atendimento está na fila de um atendente humano.' } }}",
        "options": {
          "allowUnauthorizedCerts": true
        },
        "requestMethod": "POST",
        "jsonParameters": true,
        "bodyParametersJson": "={{ { session: \"session_zeldapdv\", chatId: (String($(\"Normalizar mensagem\").item.json.phone) + \"@c.us\"), text: ($json.reply || $json.text || \"Ola! Bem-vindo ao Zelda PDV\") } }}"
