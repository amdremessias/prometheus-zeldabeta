      "id": "avisar-transferência",
      "name": "Avisar transferência",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        880,
        -180
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $('Normalizar mensagem').item.json;\nconst store = $getWorkflowStaticData('global');\nstore.sessions = store.sessions || {};\nconst key = input.phone;\nconst s = store.sessions[key] || {step:'menu', items:[], mode:'', name:'', address:'', payment:''};\nconst text = input.text.toLowerCase().trim();\nconst menu = 'Olá! Sou o atendimento do Zelda PDV. Escolha uma opção: 1 Fazer pedido, 2 Consultar pedido, 3 Ver cardápio, 4 Registrar elogio ou reclamação, 5 Falar com atendente humano.';\nlet out={...input,action:'reply',reply:menu};\nif (!text) return [{json:out}];\nif (s.step === 'human') { out.action='human'; out.reply='Seu atendimento está com a equipe humana. Aguarde uma mensagem.'; return [{json:out}]; }\nif (['menu','inicio','início'].includes(s.step)) {\n  if (/^(1|pedido|fazer pedido)/.test(text)) {s.step='mode';out.reply='Seu pedido será para entrega ou retirada no local? Responda entrega ou retirada.';}\n  else if (/^(2|status|consultar)/.test(text)) {s.step='status';out.reply='Informe o número do pedido, por exemplo 123.';}\n  else if (/^(3|cardapio|cardápio|menu)/.test(text)) {out.reply='Ainda não temos cardápio digital disponível. Em breve teremos. Obrigado e até logo!';s.step='menu';}\n  else if (/^(4|elogio|reclama|feedback)/.test(text)) {s.step='feedback';out.reply='Envie seu elogio ou reclamação em uma única mensagem.';}\n  else if (/^(5|humano|atendente)/.test(text)) {s.step='human';out.action='human';out.reply='Vou transferir você para um atendente humano. Informe brevemente o assunto.';}\n  else out.reply=menu;\n} else if (s.step==='mode') {\n  if (/entrega|delivery/.test(text)) {s.mode='delivery';s.step='name';out.reply='Informe seu nome completo.';}\n  else if (/retirada|retirar|local|pickup/.test(text)) {s.mode='takeout';s.step='name';out.reply='Informe seu nome completo.';}\n  else out.reply='Responda apenas entrega ou retirada.';\n} else if (s.step==='name') {s.name=input.text;s.step=s.mode==='delivery'?'address':'payment';out.reply=s.mode==='delivery'?'Informe o endereço completo para entrega.':'Qual será a forma de pagamento: dinheiro, cartão ou pix?';}\nelse if (s.step==='address') {s.address=input.text;s.step='payment';out.reply='Qual será a forma de pagamento: dinheiro, cartão ou pix?';}\nelse if (s.step==='payment') { if (!/dinheiro|cart[aã]o|pix/.test(text)) out.reply='Escolha dinheiro, cartão ou pix.'; else {s.payment=/pix/.test(text)?'pix':/cart/.test(text)?'cartao':'dinheiro';s.step='items';out.reply='Informe os produtos e quantidades. Exemplo: 1 Zelda Burger e 2 Refrigerante Lata.';} }\nelse if (s.step==='items') {\n  const catalog=[{id:1001,title:'Zelda Burger',price:28.9},{id:1002,title:'X-Bacon Zelda',price:34.9},{id:1003,title:'Refrigerante Lata',price:6.5}];\n  const items=[]; for (const p of catalog) {\n    const escaped=p.title.toLowerCase().replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&');\n    const m=text.match(new RegExp(String.raw`(\\\\d+)\\\\s*(?:x\\\\s*)?${escaped}`,'i'));\n    if(m) items.push({...p,quantity:Math.min(Number(m[1]),20)});\n    else if(text.includes(p.title.toLowerCase())) items.push({...p,quantity:1});\n  }\n  if (!items.length) out.reply='Não identifiquei os produtos. Use os nomes do cardápio, por exemplo: 1 Zelda Burger e 1 Refrigerante Lata.'; else {out.action='create_order';out.items=items;s.items=items;s.customer_name=s.name;s.address=s.address;s.mode=s.mode;s.payment=s.payment;out.mode=s.mode;out.name=s.name;out.address=s.address;out.payment=s.payment;store.sessions[key]= {step:'menu'};out.reply='';}\n} else if (s.step==='status') {const id=Number(text.replace(/\\D/g,'')); if(!id) out.reply='Informe apenas o número do pedido.'; else {out.action='status';out.order_id=id;s.step='menu';}}\nelse if (s.step==='feedback') {out.action='feedback';out.feedback_type=/reclama|problema|ruim/.test(text)?'reclamacao':'elogio';out.feedback_message=input.text;s.step='menu';}\nstore.sessions[key]=s;\nreturn [{json:out}];"
      },
