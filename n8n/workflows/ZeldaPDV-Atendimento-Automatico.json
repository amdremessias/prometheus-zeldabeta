    {
      "id": "pg2",
      "name": "Preparar Gemini 2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        480
      ],
      "parameters": {
        "jsCode": "const SYSTEM = \"Você é a IA de autoatendimento do restaurante Zelda PDV, atendendo clientes pelo WhatsApp.\\nRegras:\\n- Seja curto, cordial e responda sempre em português.\\n- Use as ferramentas para obter dados reais: get_menu_link (link do cardápio), check_order_status (status de pedido), register_sac_feedback (elogio/reclamação), transfer_to_human (falar com atendente humano).\\n- Se is_new_session for verdadeiro, cumprimente e ofereça o link do cardápio.\\n- Nunca invente preços ou itens; use get_menu_link para o cardápio real.\\n- Se o cliente pedir para falar com uma pessoa/atendente ou a situação exigir humano, use transfer_to_human.\\n- Ao final, não repita o cardápio completo; apenas o link ou o dado solicitado.\";\nconst fc = $('Extrair FuncCall').first().json.funcCall;\nconst toolName = $('Extrair FuncCall').first().json.toolName;\nconst toolResult = ($json && $json.body && typeof $json.body === 'object') ? $json.body : $json;\nconst base = $('Preparar Gemini 1').first().json.contents;\nconst contents = base.concat([\n  { role: 'model', parts: [{ functionCall: fc }] },\n  { role: 'user', parts: [{ functionResponse: { name: toolName, response: { result: JSON.stringify(toolResult) } } }] }\n]);\nconst geminiBody2 = { systemInstruction: { parts: [{ text: SYSTEM }] }, contents: contents, generationConfig: { maxOutputTokens: 1024 } };\nreturn [{ json: { ...$('Extrair FuncCall').first().json, geminiBody2 } }];"
