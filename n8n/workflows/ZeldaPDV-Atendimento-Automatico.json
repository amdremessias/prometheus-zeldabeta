      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2520,
        480
      ],
      "parameters": {
        "jsCode": "const up = $('Merge Checkin').first().json;\nconst g = ($json && $json.body && typeof $json.body === 'object') ? $json.body : ($json || {});\nconst cand = g.candidates && g.candidates[0];\nconst part = cand && cand.content && cand.content.parts && cand.content.parts[0];\nlet toolBranch = 'direct', toolName = null, toolArgs = null, funcCall = null, directText = null;\nif (part && part.functionCall) { funcCall = part.functionCall; toolName = funcCall.name; toolArgs = funcCall.args || {}; toolBranch = 'tool'; }\nelse if (part && part.text) { directText = part.text.trim(); }\nreturn [{ json: { ...up, toolBranch, toolName, toolArgs, funcCall, directText } }];"
      }
    },
