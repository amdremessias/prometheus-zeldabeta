    {
      "id": "pg1",
      "name": "Preparar Gemini 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        480
      ],
      "parameters": {
        "jsCode": "const SYSTEM = \"Você é a IA de autoatendimento do restaurante Zelda PDV, atendendo clientes pelo WhatsApp.\\nRegras:\\n- Seja curto, cordial e responda sempre em português.\\n- Use as ferramentas para obter dados reais: get_menu_link (link do cardápio), check_order_status (status de pedido), register_sac_feedback (elogio/reclamação), transfer_to_human (falar com atendente humano).\\n- Se is_new_session for verdadeiro, cumprimente e ofereça o link do cardápio.\\n- Nunca invente preços ou itens; use get_menu_link para o cardápio real.\\n- Se o cliente pedir para falar com uma pessoa/atendente ou a situação exigir humano, use transfer_to_human.\\n- Ao final, não repita o cardápio completo; apenas o link ou o dado solicitado.\";\nconst functions = [{\"name\":\"get_menu_link\",\"description\":\"Retorna o link público do cardápio digital do restaurante.\",\"parameters\":{\"type\":\"OBJECT\",\"properties\":{},\"required\":[]}},{\"name\":\"check_order_status\",\"description\":\"Consulta o status do pedido mais recente de um cliente pelo telefone.\",\"parameters\":{\"type\":\"OBJECT\",\"properties\":{\"phone\":{\"type\":\"STRING\",\"description\":\"telefone do cliente\"}},\"required\":[\"phone\"]}},{\"name\":\"register_sac_feedback\",\"description\":\"Registra um elogio, reclamação ou sugestão (SAC) do cliente.\",\"parameters\":{\"type\":\"OBJECT\",\"properties\":{\"phone\":{\"type\":\"STRING\"},\"kind\":{\"type\":\"STRING\",\"enum\":[\"elogio\",\"reclamacao\",\"sugestao\"]},\"message\":{\"type\":\"STRING\"}},\"required\":[\"phone\",\"message\"]}},{\"name\":\"transfer_to_human\",\"description\":\"Transfere a conversa para um atendente humano (abre ticket no CRM).\",\"parameters\":{\"type\":\"OBJECT\",\"properties\":{\"phone\":{\"type\":\"STRING\"},\"customer_name\":{\"type\":\"STRING\"},\"message\":{\"type\":\"STRING\"}},\"required\":[\"phone\",\"message\"]}}];\nconst phone = $json.phone;\nconst text = $json.text || '';\nconst isNew = ($json.checkin && $json.checkin.is_new_session) === true;\nconst ctx = 'Telefone: ' + phone + '.' + (isNew ? ' Esta é uma NOVA conversa — cumprimente e ofereça o cardápio.' : '');\nconst contents = [{ role: 'user', parts: [{ text: ctx + '\\nMensagem do cliente: ' + text }] }];\nconst geminiBody = {\n  systemInstruction: { parts: [{ text: SYSTEM }] },\n  contents: contents,\n  generationConfig: { maxOutputTokens: 1024 },\n  tools: [{ functionDeclarations: functions }]\n};\nreturn [{ json: { ...$json, contents, geminiBody } }];"
      }
    },
