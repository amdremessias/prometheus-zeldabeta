      "name": "Montar Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3820,
        480
      ],
      "parameters": {
        "jsCode": "const up = $('Extrair FuncCall').first().json;\nlet reply;\nif (up.directText && up.directText.trim()) { reply = up.directText.trim(); }\nelse {\n  const g2 = ($json && $json.body && typeof $json.body === 'object') ? $json.body : $json;\n  const cand = g2.candidates && g2.candidates[0];\n  const part = cand && cand.content && cand.content.parts && cand.content.parts[0];\n  reply = (part && part.text) ? part.text.trim() : 'Desculpe, não consegui processar agora. Um atendente vai te ajudar em instantes.';\n}\nreturn [{ json: { phone: up.phone, chatId: up.chatId, channel: up.channel, reply } }];"
      }
