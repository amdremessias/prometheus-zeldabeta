      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        400
      ],
      "parameters": {
        "jsCode": "const root = $json || {};\nconst b = (root.body && typeof root.body === 'object') ? root.body : root;\nconst payload = (b.payload && typeof b.payload === 'object') ? { ...b, ...b.payload } : b;\nconst rawChatId = String(payload.chatId || payload.chat_id || payload.from || payload.to || b.chatId || '');\nconst phone = String(payload.phone || payload.from || rawChatId || '').replace(/@(c\\.us|lid)$/i, '').trim();\nconst text = String(payload.text || payload.body || payload.message || '').trim();\nconst name = String(payload.pushName || payload.customer_name || payload.customerName || payload.notifyName || '');\nconst channel = String(payload.channel || (rawChatId.endsWith('@lid') ? 'cloud_api' : 'waha'));\nreturn [{ json: { phone, text, name, chatId: rawChatId, channel } }];"
      }
    },
