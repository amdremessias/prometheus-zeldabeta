# ZeldaPDV — variáveis para WhatsApp e IA. Mescle no .env privado da stack.
# Gere segredos fortes e únicos por instância; não os comite.
ZELDAPDV_WEBHOOK_SECRET=
WAHA_WEBHOOK_HMAC_KEY=

# WhatsApp: escolha waha ou meta; complete só as variáveis desse provedor.
WHATSAPP_PROVIDER=waha
WAHA_API_URL=http://waha-zeldapdv:3000
WAHA_API_KEY=
WAHA_SESSION=session_zeldapdv
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_GRAPH_VERSION=v20.0

# IA por instância: n8n, gemini ou gateway.
ZELDAPDV_AI_PROVIDER=n8n
ZELDAPDV_AI_WEBHOOK_URL=http://n8n-zeldapdv:5678/webhook/zeldapdv-gemini
ZELDAPDV_AI_TIMEOUT_MS=20000
ZELDAPDV_AI_GATEWAY_URL=
ZELDAPDV_AI_GATEWAY_API_KEY=
ZELDAPDV_AI_GATEWAY_MODEL=default
ZELDAPDV_AI_GATEWAY_TIMEOUT_MS=30000
ZELDAPDV_AI_FALLBACK_TO_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
